generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum EventStatus {
  NEW
  CONFIRMED
  UPCOMING
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  CASH
  TRANSFER
  BIT
  PAYBOX
  CARD
  OTHER
}
model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}
model EventType {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  events Event[]
}
model Event {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventTypeId  String
  eventType    EventType   @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  date         DateTime    @db.Date
  time         String     @default("")
  location     String     @default("")
  city         String     @default("")
  venue        String     @default("")
  price        Int
  status       EventStatus @default(NEW)
  notes        String     @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  version      Int         @default(1)
  requestId    String      @unique
  payments     Payment[]
  @@index([date, status])
  @@index([clientId])
}
model Payment {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amount    Int
  date      DateTime      @db.Date
  method    PaymentMethod
  note      String        @default("")
  requestId String        @unique
  createdAt DateTime      @default(now())
  @@index([eventId, date])
}
